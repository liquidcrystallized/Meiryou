<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Meiryou.ViewModels"
             xmlns:models="clr-namespace:Meiryou.Core.Models;assembly=Meiryou.Core"
             mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="800"
             x:CompileBindings="True"
             x:Class="Meiryou.Views.ReaderScreenView"
             x:DataType="vm:ReaderScreenViewModel">
 
    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <UniformGrid Grid.Row="0" Rows="1" Columns="3" DockPanel.Dock="Top">
            <!-- Not sure if having buttons here is good ui, but it's okay for testing for now. -->
            <Button HorizontalAlignment="Center" VerticalAlignment="Center" Command="{Binding NavigateBackCommand}">Back</Button>
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">ReaderScreenView</TextBlock>
        </UniformGrid>
       
        <!-- This is where the reading content is displayed -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" PointerPressed="ScrollViewer_OnPointerPressed">
            <ItemsControl ItemsSource="{Binding Words}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WordEntry">
                        <TextBlock FontSize="20" 
                                   Text="{Binding Word.Text}" 
                                   Background="{Binding Word.FamiliarityLevel, Converter={StaticResource FamiliarityToGradientBrushConverter}}"
                                   Cursor="Hand"
                                   PointerPressed="InputElement_OnPointerPressed"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
      
        <!-- Popup for word definitions are here -->
       <Grid Grid.Row="2" IsVisible="{Binding IsPopupVisible}">
           <Grid RowDefinitions="Auto,Auto">
               <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*,*">
                   <RadioButton Grid.Column="0" 
                                GroupName="Familiarity Level Group" 
                                Content="New" 
                                HorizontalAlignment="Center"
                                IsChecked="{Binding SelectedFamiliarityLevel,
                                Converter={StaticResource EnumToBoolConverter},
                                ConverterParameter={x:Static models:WordFamiliarityLevel.New}}"/>
                   <RadioButton Grid.Column="1" 
                                GroupName="Familiarity Level Group" 
                                Content="Learning" 
                                HorizontalAlignment="Center"/>
                   <RadioButton Grid.Column="2" 
                                GroupName="Familiarity Level Group" 
                                Content="Familiar" 
                                HorizontalAlignment="Center"
                                IsChecked="{Binding SelectedFamiliarityLevel,
                                Converter={StaticResource EnumToBoolConverter},
                                ConverterParameter={x:Static models:WordFamiliarityLevel.Familiar}}"/>
                   <RadioButton Grid.Column="3" 
                                GroupName="Familiarity Level Group" 
                                Content="Known" 
                                HorizontalAlignment="Center"
                                IsChecked="{Binding SelectedFamiliarityLevel,
                                Converter={StaticResource EnumToBoolConverter},
                                ConverterParameter={x:Static models:WordFamiliarityLevel.Known}}"/>
                   <RadioButton Grid.Column="4" 
                                GroupName="Familiarity Level Group" 
                                Content="Well Known" 
                                HorizontalAlignment="Center"
                                IsChecked="{Binding SelectedFamiliarityLevel,
                                Converter={StaticResource EnumToBoolConverter},
                                ConverterParameter={x:Static models:WordFamiliarityLevel.WellKnown}}"/>
               </Grid>
               <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                   <TextBlock FontSize="18" FontWeight="Bold"
                              Text="{Binding SelectedWord.Word.Text}"
                              Margin="0,0,0,10"/>
                   <TextBlock FontSize="14" 
                              Text="{Binding SelectedWord.Word.Definition}" 
                              Margin="0,0,0,5"/>
                   <TextBlock FontSize="14" FontStyle="Italic"
                              Text="{Binding SelectedWord.Word.PartOfSpeech}" 
                              Margin="0,0,0,5"/>
                   <TextBlock FontSize="14"
                              Text="{Binding SelectedWord.Word.FrequencyRank, StringFormat='Frequency Rank: {0}'}" 
                              Margin="0,0,0,5"/>
                   <TextBlock FontSize="14"
                              Text="{Binding SelectedWord.Word.FamiliarityLevel }"
                              Margin="0, 0, 0, 5"/>
               </StackPanel>
           </Grid>
       </Grid> 
        
        <UniformGrid Grid.Row="3" Rows="1" Columns="1" DockPanel.Dock="Bottom">
            <TextBlock FontSize="16" 
                       Text="{Binding UrlPathSegment}" 
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </UniformGrid>
    </Grid>
    
</UserControl>
